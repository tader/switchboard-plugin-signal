      ],
      "additionalProperties": false
    },
    "conversation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "title": {
          "type": "string",
          "maxLength": 65536
        },
        "kind": {
          "enum": [
            "direct",
            "group",
            "channel",
            "agent"
          ]
        },
        "unread": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "unread"
      ],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 262144
        },
        "authorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "replyToId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "contentState": {
          "enum": [
            "available",
            "unavailable",
            "restricted",
            "deleted"
          ]
        },
        "contentType": {
          "enum": [
            "text",
            "media",
            "poll",
            "system",
            "unknown"
          ]
        },
        "reactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "emoji": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "me": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "emoji",
              "count",
              "me"
            ],
            "additionalProperties": false
          }
        },
        "isOwn": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "conversationId",
        "text",
        "authorId",
        "createdAt",
        "contentState",
        "contentType",
        "isOwn"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "contentState": {
                "enum": [
                  "restricted",
                  "deleted",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "text": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "thread": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "replyCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "id",
        "conversationId",
        "title",
        "replyCount"
      ],
      "additionalProperties": false
    }
  }
}
