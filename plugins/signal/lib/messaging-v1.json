  "definitions": {
    "coverage": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "complete"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "uncertain"
          ]
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
